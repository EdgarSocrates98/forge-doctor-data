    "python_api": {
      "entries": {
        "DataPlatformGraph": {
          "kind": "callable",
          "signature": "(_entities: 'dict[str, Entity]' = <factory>, _edges: 'set[Relationship]' = <factory>, _out: 'dict[str, list[Relationship]]' = <factory>, _in: 'dict[str, list[Relationship]]' = <factory>) -> None"
        },
        "SCAN_SCHEMA_VERSION": {
          "kind": "constant",
          "signature": null
        },
        "SCHEMA_VERSION": {
          "kind": "constant",
          "signature": null
        },
        "ScanOptions": {
          "kind": "callable",
          "signature": "(categories: 'tuple[str, ...]' = (), ignore: 'tuple[str, ...]' = (), fail_on: 'str' = 'error', verbose: 'bool' = False, use_cache: 'bool | None' = None, overlay: 'Mapping[str, str] | None' = None, hermetic: 'bool' = False) -> None"
        },
        "ScanReport": {
          "kind": "callable",
          "signature": "(version: 'str', project: 'Path', results: 'list[CheckResult]' = <factory>, baseline: 'BaselineDiff | None' = None, suppressions: 'tuple[SuppressionRecord, ...]' = ()) -> None"
        },
        "capabilities_evaluate": {
          "kind": "callable",
          "signature": "(platform: 'str', capability: 'str', *, version: 'str | None' = None, attributes: 'dict[str, str] | None' = None) -> 'str'"
        },
        "migrate_plans": {
          "kind": "callable",
          "signature": "(path: 'str | Path' = '.') -> 'list[MigrationPlan]'"
        },
        "platform_graph": {
          "kind": "callable",
          "signature": "(path: 'str | Path' = '.') -> 'DataPlatformGraph'"
        },
        "scan": {
          "kind": "callable",
          "signature": "(path: 'str | Path' = '.', *, profile: 'str' = 'default', ignore: 'tuple[str, ...]' = ()) -> 'ScanReport'"
        },
        "version": {
          "kind": "callable",
          "signature": "() -> 'str'"
        },
        "what_if": {
          "kind": "callable",
          "signature": "(path: 'str | Path', changes: 'dict[str, str]') -> 'list[WhatIfReport]'"
        }
      },
      "module": "forge_doctor_data.api",
      "stability": "stable"
    }
