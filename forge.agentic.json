{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "forge-doctor-data",
  "version": "1.1.3",
  "cli": "forge-doctor-data",
  "cli_entry": "forge_doctor_data.cli:app",
  "workflows": [
    {
      "id": "scan",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "scan",
        "{target}"
      ],
      "description": "Independent data-platform diagnostic",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "install",
        "doctor"
      ],
      "description": "Installation health",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "data-diagnostic-investigator",
    "data-quality-reviewer",
    "data-platform-reviewer"
  ],
  "agent_roster_paths": [
    "src/forge_doctor_data/installation/assets/agents"
  ],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true,
  "resources": [
    {
      "id": "data-diagnostic-investigator",
      "kind": "agent",
      "location": "src/forge_doctor_data/installation/assets/agents/data-diagnostic-investigator.md",
      "resource_class": "agentic"
    },
    {
      "id": "data-platform-reviewer",
      "kind": "agent",
      "location": "src/forge_doctor_data/installation/assets/agents/data-platform-reviewer.md",
      "resource_class": "agentic"
    },
    {
      "id": "data-quality-reviewer",
      "kind": "agent",
      "location": "src/forge_doctor_data/installation/assets/agents/data-quality-reviewer.md",
      "resource_class": "agentic"
    },
    {
      "id": "examples/plugin",
      "kind": "example",
      "location": "examples/plugin",
      "resource_class": "read-only"
    }
  ]
}
