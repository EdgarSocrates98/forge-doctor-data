{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "forge-doctor-data",
  "version": "1.0.0rc1",
  "cli": "forge-doctor-data",
  "cli_entry": "forge_doctor_data.cli:app",
  "workflows": [
    {
      "id": "scan",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "scan",
        "{target}"
      ],
      "description": "Independent data-platform diagnostic",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "install",
        "doctor"
      ],
      "description": "Installation health",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true
}
