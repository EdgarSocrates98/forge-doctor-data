{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "forge-doctor-data",
  "version": "1.1.3",
  "cli": "forge-doctor-data",
  "cli_entry": "forge_doctor_data.cli:app",
  "workflows": [
    {
      "id": "scan",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "scan",
        "{target}"
      ],
      "description": "Independent data-platform diagnostic",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "install",
        "doctor"
      ],
      "description": "Installation health",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "data-diagnostic-investigator",
    "data-quality-reviewer",
    "data-platform-reviewer"
  ],
  "agent_roster_paths": [
    "src/forge_doctor_data/installation/assets/agents"
  ],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp"
  ],
  "mcp_verify_tool": "get_execution_baseline",
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true,
