{
  "forge_id": "forge-doctor-data",
  "package": "forge_doctor_data",
  "distribution": "forge-doctor-data",
  "cli": "forge-doctor-data",
  "python": ">=3.11",
  "mcp_server_name": "forge-doctor-data",
  "mcp_command": [
    "forge-doctor-data",
    "mcp"
  ],
  "extras": [],
  "lab": {
    "command": [
      "{python}",
      "scripts/lab/forge_doctor_data_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "forge-doctor-data-lab",
    "timeout_s": 300
  }
}
